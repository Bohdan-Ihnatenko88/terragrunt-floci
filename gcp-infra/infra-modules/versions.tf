# The "google" provider with floci endpoints is generated by Terragrunt from gcp-infra/root.hcl.
# Run this module via terragrunt from infra/<env>/<unit>, not with terraform directly.
terraform {
  required_version = ">= 1.6"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 7.36" # same branch the floci-gcp compat tests run on
    }
  }
}
